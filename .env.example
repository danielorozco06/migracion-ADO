# Azure DevOps Agent Configuration
# Copy from .env.example and fill in your values

# Required: Azure DevOps organization URL
# Example: https://dev.azure.com/myorg
AZP_URL=https://dev.azure.com/****

# Required: Personal Access Token for authentication
# Create at: https://dev.azure.com/<org>/_usersSettings/tokens
# Scope: Agent Pools (read, manage)
AZP_TOKEN=*****

# Optional: Agent pool name (defaults to: Default)
AZP_POOL=Migracion

# Optional: Docker Swarm service name (defaults to: ado-agent)
SERVICE_NAME=ado-agent

# Optional: Number of agent replicas in the Swarm service (defaults to: 2)
REPLICAS=2

# Optional: Docker image name (defaults to: ado-agent:latest)
IMAGE=ado-agent:latest

